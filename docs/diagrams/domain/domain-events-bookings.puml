@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0

skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam class {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #555555
}
skinparam nodesep 100
skinparam ranksep 100

skinparam ArrowThickness 1.2
skinparam ArrowFontStyle bold
skinparam ArrowFontSize 11
skinparam ArrowColor #444444

package "event" {
    class Event <<Entity - Immutable>> {
        - id: Long
        - creatorId: Long
        - organiserId: Long
        - venueId: Long
        - name: String
        - startDateTime: LocalDateTime
        - endDateTime: LocalDateTime
        - capacity: int
        - price: BigDecimal
        - status: EventStatus
        - visibility: EventVisibility
        - publishedAt: LocalDateTime
    }

    enum EventStatus {
        DRAFT
        CONFIRMED
        PUBLISHED
        CANCELLED
    }

    enum EventVisibility {
        PUBLIC
        PRIVATE
    }
}

package "booking" {
    class Booking <<Entity - Immutable>> {
        - id: Long
        - userId: Long
        - eventId: Long
        - totalPrice: BigDecimal
        - status: BookingStatus
    }

    class Ticket <<Entity - Immutable>> {
        - id: Long
        - bookingId: Long
        - ticketHolderName: String
        - eventStartDateTime: LocalDateTime
    }

    enum BookingStatus {
        PENDING_PAYMENT
        CONFIRMED
        CANCELLED
    }
}

package "feedback" {
    class Review <<Entity - Immutable>> {
        - id: Long
        - userId: Long
        - eventId: Long
        - rating: int
        - comment: String
    }
}

Event "1 " --> "1   " EventStatus : " l'evento è"
Event "1 " ---> "1   " EventVisibility : " la visibilità dell'evento è"
Booking "1 " --> "1    " BookingStatus : "la prenotazione è"
Booking "1   " *-- "1..* " Ticket : " contiene"
Event "0..*    " <-left- " 1" Booking : "prenota                        "
Event "    0..*" <-right- "1    " Review : " valuta"
@enduml