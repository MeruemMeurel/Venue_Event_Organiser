@startuml
skinparam style strictuml
skinparam shadowing false
skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12

skinparam state {
    BackgroundColor #F5F7FA
    BorderColor #A0AEC0
    FontColor #2D3748
    FontSize 13
    FontStyle bold

    ArrowColor #4A5568
    ArrowThickness 1.6
    ArrowFontColor #4A5568
    ArrowFontSize 11
}

skinparam ranksep 100
skinparam nodesep 120

[*] --> PENDING : createRequest() [actor = requester] / force PENDING

PENDING -left-> ACCEPTED : acceptRequest() [actor = handler e quote >= 0]\n/ setClosedAt(now)
PENDING --> REJECTED : rejectRequest() [actor = handler] / setClosedAt(now)
PENDING -right-> CANCELLED : cancelRequest() [actor = requester] / setClosedAt(now)

@endum
